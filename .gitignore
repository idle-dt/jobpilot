# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
credentials.json
token.json

# Database
*.db

# OS
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.pytest_cache/

# Poetry
poetry.lock

# Model artifacts
*.pkl

# Claude Code — track shared config, ignore machine-local state
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/settings.json
.superpowers/

# Internal docs — track decisions, todos, and the specs template; ignore the rest
docs/*
!docs/decisions/
!docs/todos/
!docs/specs/
docs/specs/*
!docs/specs/SPEC_TEMPLATE.md
# The labeling criteria decide what every bulk label means, so they are versioned
# alongside the code that reads them — a local-only copy has no history.
!docs/labeling-criteria.md
